# Copy this file to .env and fill in your own values.
# Never commit or share the real .env file.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Long random string used to sign Flask sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Set to true only when serving the app over HTTPS.
FLASK_SESSION_COOKIE_SECURE=false

# Administrator credentials for the dedicated /staff_login page.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-password
INITIAL_ADMIN_NAME=Site Administrator
